module Docscribe
  module Validator
    class TypeMismatchValidator
      @fallback_type: String

      class Result
        attr_accessor type: Symbol
        attr_accessor yard_type: String?
        attr_accessor expected_type: String?
        attr_accessor message: String

        def initialize: (?type: Symbol, ?yard_type: String?, ?expected_type: String?, ?message: String) -> void
      end

      def initialize: (?fallback_type: String) -> void

      def mismatched_param?: ((String | nil) yard_type, (String | nil) expected_type) -> bool

      def mismatched_return?: ((String | nil) yard_type, (String | nil) expected_type) -> bool

      def invalid_syntax?: ((String | nil) yard_type) -> bool

      def check_return: ((String | nil) yard_type, (String | nil) expected_type) -> (Result | nil)

      def check_param: (String param_name, (String | nil) yard_type, (String | nil) expected_type) -> (Result | nil)

      def invalid_return_result: ((String | nil) yard_type, (String | nil) expected_type) -> Result

      def mismatch_return_result: ((String | nil) yard_type, (String | nil) expected_type) -> Result

      def invalid_param_result: (String param_name, (String | nil) yard_type, (String | nil) expected_type) -> Result

      def mismatch_param_result: (String param_name, (String | nil) yard_type, (String | nil) expected_type) -> Result

      private

      def normalize: (String type_str) -> String
    end
  end
end
